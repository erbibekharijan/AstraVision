# ==============================================================================
# ASTRA VISION — Environment Variables Configuration
# ==============================================================================
# Precedence Rule: Environment Variables > .env file > config.yaml
# Copy this file to .env to customize local paths, devices, and runtime settings.

# Optional Hugging Face token. Not required for public models (ConvNeXt, CLIP).
HF_TOKEN=

# Directory for caching Hugging Face models and datasets (default: ~/.cache/huggingface)
HF_HOME=

# Computation device: 'auto' (selects CUDA if available, else CPU), 'cpu', 'cuda', 'mps'
DEVICE=auto

# Workspace directory overrides (relative or absolute paths)
DATA_DIR=./data
MODEL_DIR=./models
OUTPUT_DIR=./outputs

# Maximum allowed image upload size in Megabytes
MAX_UPLOAD_MB=10

# Override confidence threshold for uncertain prediction warning (e.g. 0.60)
CONFIDENCE_THRESHOLD=

# Logging level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO
